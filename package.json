{
  "name": "dotnet-junior-academy",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": ".NET Backend Academy: Astro static site. Content in content/ (YAML + code files), published on GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "tsx tools/check.ts && astro check",
    "test": "tsx tools/check.ts && npm run build && tsx tools/smoke.ts",
    "new:lesson": "tsx tools/new.ts lesson",
    "new:module": "tsx tools/new.ts module",
    "format": "prettier --write \"src/**/*.{ts,astro,css}\" \"tools/**/*.ts\" \"*.mjs\""
  },
  "dependencies": {
    "astro": "^7.4.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^22.20.5",
    "pagefind": "^1.2.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
