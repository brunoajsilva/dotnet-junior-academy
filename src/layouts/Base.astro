---
import "../styles/index.css";
import { LOGO_MARK, setBaseUrl, rewriteHashLinks } from "../lib/html";
import { createRenderContext } from "../lib/render/context";
import { renderModuleSwitcher, renderProgressPill, renderSideMenu } from "../lib/render/navigation";
import { emptyProgress } from "../lib/progress";
import { extraModuleColours, type Site } from "../lib/site";

interface Props {
  routeId: string;
  site: Site;
  title: string;
  mainHtml: string;
}
const { routeId, site, title, mainHtml } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
setBaseUrl(baseUrl);

const context = createRenderContext(site, emptyProgress(), routeId);
const extraColours = Object.entries(extraModuleColours(site.modules))
  .map(([name, value]) => `${name}:${value}`)
  .join(";");
---

<!doctype html>
<html lang="pt-PT" data-base={baseUrl} style={extraColours || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta
      name="description"
      content=".NET Backend Academy interativa: introdução, C#, .NET, autenticação e projeto final com Clean Architecture."
    />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body data-route={routeId}>
    <header class="topbar pad">
      <div class="in">
        <button class="ibtn menu-btn" id="menuBtn" aria-label="Abrir índice" aria-expanded="false">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
          >
        </button>
        <button class="brand" data-go-to-route="" aria-label=".NET Backend Academy, página inicial">
          <Fragment set:html={LOGO_MARK} /><span class="wm"><b>.NET</b> Backend Academy</span>
        </button>
        <nav
          class="modnav"
          id="modnav"
          aria-label="Módulos"
          set:html={rewriteHashLinks(renderModuleSwitcher(context))}
        />
        <span class="pill" id="pill" set:html={renderProgressPill(context)} />
      </div>
    </header>
    <div class="shell pad">
      <nav
        class="side"
        id="side"
        aria-label="Índice dos módulos"
        set:html={rewriteHashLinks(renderSideMenu(context))}
      />
      <main id="main" tabindex="-1" data-pagefind-body set:html={rewriteHashLinks(mainHtml)} />
    </div>
    <div class="scrim" id="scrim"></div>
    <div class="dr-scrim" id="drScrim"></div>
    <aside
      class="drawer"
      id="drawer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="drTitle"
      aria-hidden="true"
    >
      <div class="dh">
        <p class="eyebrow">Saber mais</p>
        <button class="ibtn" id="drClose" aria-label="Fechar painel">Fechar <kbd>Esc</kbd></button>
      </div>
      <div class="db" id="drBody"></div>
    </aside>
    <noscript
      ><p style="padding: 24px">
        O progresso e os exercícios interativos precisam de JavaScript.
      </p></noscript
    >
    <script>
      import "../client/app";
    </script>
  </body>
</html>
